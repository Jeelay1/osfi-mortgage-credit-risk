    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read it",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#0B0B0B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Before the hikes, the Stage 3 share was drifting down about 1.2 bp a quarter. From April 2022 the trend turned up to about 2.0 bp a quarter: a change of +3.2 bp a quarter (p < 0.001).",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#0B0B0B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Bank-level panel with bank fixed effects: +3.6 bp a quarter (p < 0.001, Driscoll-Kraay standard errors).",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#0B0B0B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Robust to moving the break to Jul 2022, Oct 2022 or Jan 2023 and to dropping the pandemic quarters: the trend change stays between +3.7 and +4.0 bp a quarter.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#0B0B0B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "What it does not show",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#0B0B0B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Timing, not cause. Unemployment, home prices and the pandemic payment deferrals moved at the same time. Residuals are autocorrelated, so the standard errors are HAC-adjusted; the full diagnostics are in the notebook.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#52514E"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
