/// Raw GitHub URL of the data/processed folder (must end with a slash). Point it at a fork or another branch to read those files instead.
expression GitHubDataUrl = "https://raw.githubusercontent.com/Jeelay1/osfi-mortgage-credit-risk/main/data/processed/" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	lineageTag: e1cbf18f-44ea-5b00-93c0-d23a3b42e229

	annotation PBI_ResultType = Text

/// Reads one CSV from data/processed on GitHub, promotes headers and turns empty cells into nulls.
expression fnReadCsv =
		(fileName as text) as table =>
		let
		    Source = Web.Contents(GitHubDataUrl, [RelativePath = fileName]),
		    Csv = Csv.Document(Source, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    Promoted = Table.PromoteHeaders(Csv, [PromoteAllScalars = true]),
		    BlanksToNull = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _)
		in
		    BlanksToNull
	lineageTag: 5e98643c-6999-5068-974f-3a561cf9f841

	annotation PBI_ResultType = Function

