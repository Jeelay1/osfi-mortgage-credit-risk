model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["GitHubDataUrl", "fnReadCsv", "Key Measures", "Bank", "Calendar", "Product", "Insurance", "Stage", "Credit Stage", "Mortgage Balances", "Reconciliation", "Allowance Drivers", "Stage 3 Trend Model", "Data Quality", "Metric", "Migration Scenario"]

ref table 'Key Measures'
ref table Bank
ref table Calendar
ref table Product
ref table Insurance
ref table Stage
ref table 'Credit Stage'
ref table 'Mortgage Balances'
ref table Reconciliation
ref table 'Allowance Drivers'
ref table 'Stage 3 Trend Model'
ref table 'Data Quality'
ref table Metric
ref table 'Migration Scenario'

